<select id="hora" name="Hora" class="form-control"></select>

<script>
    function cargarHoras() {
        let idBarbero = document.getElementById("barbero").value;
        let fecha = document.getElementById("fecha").value;

        if (!idBarbero || !fecha) return;

        fetch(`/Citas/HorasDisponibles?idBarbero=${idBarbero}&fecha=${fecha}`)
            .then(res => res.json())
            .then(data => {
                let select = document.getElementById("hora");
                select.innerHTML = "";

                if (data.length === 1 && data[0] === "NO DISPONIBLE") {
                    let option = document.createElement("option");
                    option.text = "NO DISPONIBLE";
                    option.disabled = true;
                    select.appendChild(option);
                    return;
                }

                data.forEach(h => {
                    let option = document.createElement("option");
                    option.value = h;
                    option.text = h;
                    select.appendChild(option);
                });
            });
    }
</script>