@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center vh-100">

    <div class="card shadow p-4" style="width: 400px; border-radius:15px;">

        <!-- LOGO -->
        <div class="text-center mb-3">
            <img src="~/img/CBS1.png" width="100" />
        </div>

        <h3 class="text-center text-primary mb-4">Inicio de Sesión</h3>

        <!-- 🔥 MENSAJE DESPUÉS DE RESET -->
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success text-center">
                @TempData["Mensaje"]
            </div>
        }

        <form method="post">

            <div class="mb-3">
                <label>Correo</label>
                <input type="email" name="correo" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Contraseña</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary">
                    🔐 Ingresar
                </button>
            </div>

            <div class="text-center mt-3">
                <a asp-action="Recuperar" class="text-decoration-none">
                    ¿Olvidaste tu contraseña?
                </a>
            </div>

        </form>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-3 text-center">
                @ViewBag.Error
            </div>
        }

    </div>

</div>