@model Barberia.Entidades.Barbero

<div class="container mt-4">

    <h2 class="text-warning mb-4">Editar Barbero</h2>

    <div class="card shadow p-4">

        <form id="formEditar" method="post">

            <input type="hidden" asp-for="IdBarbero" />
            <input type="hidden" asp-for="IdUsuario" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Nombre</label>
                    <input asp-for="Nombre" class="form-control" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Apellido</label>
                    <input asp-for="Apellido" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label>Correo</label>
                <input asp-for="Correo" type="email" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input asp-for="Password" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Teléfono</label>
                <input asp-for="Telefono" class="form-control" required />
            </div>

            <div class="mt-4">
                <button type="button" onclick="editar()" class="btn btn-warning">
                    ✏️ Actualizar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

        </form>

    </div>

</div>

<script>
    function editar() {
        Swal.fire({
            title: '¿Actualizar barbero?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, actualizar'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById("formEditar").submit();
            }
        });
    }
</script>