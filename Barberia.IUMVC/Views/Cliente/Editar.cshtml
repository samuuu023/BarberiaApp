@model Barberia.Entidades.Cliente

<div class="container mt-4">

    <h2 class="text-warning mb-4">Editar Cliente</h2>

    <div class="card shadow p-4">

        <form id="formEditar" method="post">

            <input type="hidden" asp-for="IdCliente" />
            <input type="hidden" asp-for="IdUsuario" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Nombre</label>
                    <input asp-for="Nombre" class="form-control" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Apellido</label>
                    <input asp-for="Apellido" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label>Correo</label>
                <input asp-for="Correo" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input asp-for="Password" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Teléfono</label>
                <input asp-for="Telefono" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Fecha de Nacimiento</label>
                <input asp-for="FechaNacimiento" type="date" class="form-control" required />
            </div>

            <!-- 🔥 BOTONES BIEN POSICIONADOS -->
            <div class="mt-4">
                <button type="button" onclick="editar()" class="btn btn-warning">
                    ✏️ Actualizar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

        </form>

    </div>

</div>

<script>
    function editar(){
        Swal.fire({
            title:'¿Actualizar cliente?',
            icon:'question',
            showCancelButton:true,
            confirmButtonText:'Sí, actualizar'
        }).then(r=>{
            if(r.isConfirmed){
                document.getElementById("formEditar").submit();
            }
        });
    }
</script>