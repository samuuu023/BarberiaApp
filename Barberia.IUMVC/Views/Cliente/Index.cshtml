@model List<Barberia.Entidades.Cliente>

<div class="container mt-4">

    <h2 class="text-primary mb-4">Clientes</h2>

    <form method="get" class="d-flex mb-3">
        <input type="text" name="buscar" value="@Context.Request.Query["buscar"]" class="form-control me-2" placeholder="Buscar..." />
        <button class="btn btn-primary me-2">Buscar</button>
        <a href="/Cliente" class="btn btn-secondary">Limpiar</a>
    </form>

    <a asp-action="Crear" class="btn btn-success mb-3">+ Nuevo</a>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Nombre</td>
                    <td>@c.Apellido</td>
                    <td>@c.Correo</td>
                    <td>@c.Telefono</td>

                    <td>
                        <a asp-action="Ver" asp-route-id="@c.IdCliente" class="btn btn-info btn-sm">👁</a>
                        <a asp-action="Editar" asp-route-id="@c.IdCliente" class="btn btn-warning btn-sm">✏️</a>
                        <button onclick="eliminar(@c.IdCliente)" class="btn btn-danger btn-sm">🗑</button>
                    </td>

                </tr>
            }
        </tbody>
    </table>

</div>

<script>
    function eliminar(id){
    Swal.fire({
    title:'¿Eliminar cliente?',
    showCancelButton:true
    }).then(r=>{
    if(r.isConfirmed){
    window.location='/Cliente/Eliminar/'+id;
    }
    });
    }
</script>