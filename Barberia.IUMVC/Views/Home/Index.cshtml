@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-5">

    <!-- LOGO -->
    <img src="~/img/CBS1.png" alt="Logo Barbería" width="120" class="mb-3" />

    <h1 class="display-3 fw-bold">COOL BARBER SHOP</h1>
    <p class="lead">Estilo, precisión y calidad en cada corte</p>
</div>

<hr />

<!-- SOBRE NOSOTROS -->
<div class="mb-5">
    <h2 class="text-center">Sobre Nosotros</h2>
    <p class="text-center">
        En COOL BARBER SHOP ofrecemos cortes clásicos, modernos y urbanos con barberos profesionales.
        Nos especializamos en brindar estilo y confianza a cada cliente.
    </p>
</div>

<hr />

<!-- GALERÍA -->
<div class="mb-5">
    <h2 class="text-center mb-4">Galería de Cortes</h2>

    <!-- CLÁSICOS -->
    <h4>Clásicos</h4>
    <div class="row mb-4">
        <div class="col-md-3">
            <img src="~/images/clasico1.jpg" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-3">
            <img src="~/images/clasico2.jpg" class="img-fluid rounded shadow" />
        </div>
    </div>

    <!-- MODERNOS -->
    <h4>Modernos</h4>
    <div class="row mb-4">
        <div class="col-md-3">
            <img src="~/images/moderno1.jpg" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-3">
            <img src="~/images/moderno2.jpg" class="img-fluid rounded shadow" />
        </div>
    </div>

    <!-- URBANOS -->
    <h4>Urbanos</h4>
    <div class="row mb-4">
        <div class="col-md-3">
            <img src="~/images/urbano1.jpg" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-3">
            <img src="~/images/urbano2.jpg" class="img-fluid rounded shadow" />
        </div>
    </div>
</div>

<hr />

<!-- UBICACIÓN -->
<div class="mb-5">
    <h2 class="text-center mb-4">Ubicación</h2>

    <div class="d-flex justify-content-center">
        <div style="width: 100%; max-width: 600px;">

            <!-- GOOGLE MAPS CORRECTO -->
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d254.11474696104065!2d-89.72490422664721!3d13.723350490538731!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f62b7c321b1eb19%3A0x4001d9af3d11d5e9!2sCool%20Barbershop!5e0!3m2!1ses!2ssv!4v1774162813482!5m2!1ses!2ssv"
                    width="100%" height="350" style="border:0;"
                    allowfullscreen="" loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
            </iframe>

        </div>
    </div>
</div>

<hr />