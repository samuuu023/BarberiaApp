@model Barberia.Entidades.Usuario

<div class="container mt-4">

    <h2 class="text-success mb-4">Nuevo Usuario</h2>

    <div class="card shadow p-4">

        <form id="formCrear" method="post">

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Nombre</label>
                    <input asp-for="Nombre" class="form-control" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Apellido</label>
                    <input asp-for="Apellido" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label>Correo</label>
                <input asp-for="Correo" type="email" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input asp-for="Password" type="password" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Rol</label>
                <input asp-for="Rol" class="form-control" required />
            </div>

            <div class="mt-4">
                <button type="button" onclick="guardar()" class="btn btn-success">
                    💾 Guardar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

        </form>

    </div>

</div>

<script>
    function guardar() {
        Swal.fire({
            title: '¿Crear usuario?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, crear'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById("formCrear").submit();
            }
        });
    }
</script>