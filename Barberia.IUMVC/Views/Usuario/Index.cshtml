@model List<Barberia.Entidades.Usuario>

<h2>Usuarios</h2>

<div class="row mb-3">

    <div class="col-4">
        <a asp-action="Crear" class="btn btn-primary">
            Nuevo Usuario
        </a>
    </div>

    <div class="col-4">
        <form method="get" asp-action="Index">
            <input type="text" name="buscar" class="form-control" placeholder="Buscar usuario..." />
        </form>
    </div>

</div>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var u in Model)
        {
            <tr>
               
                <td>@u.Nombre</td>
                <td>@u.Apellido</td>
                <td>@u.Correo</td>
                <td>@u.Rol</td>

                <td>

                    <a asp-action="Ver" asp-route-id="@u.IdUsuario" class="btn btn-info btn-sm">
                        Ver
                    </a>

                    <a asp-action="Editar" asp-route-id="@u.IdUsuario" class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Eliminar" asp-route-id="@u.IdUsuario" class="btn btn-danger btn-sm">
                        Eliminar
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>
