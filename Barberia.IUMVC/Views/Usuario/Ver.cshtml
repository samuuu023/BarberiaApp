@model Barberia.Entidades.Usuario

<div class="container mt-4">

    <h2 class="text-info mb-4">Detalle del Usuario</h2>

    <div class="card shadow p-4">

        <p><b>Nombre:</b> @Model.Nombre</p>
        <p><b>Apellido:</b> @Model.Apellido</p>
        <p><b>Correo:</b> @Model.Correo</p>
        <p>
            <b>Rol:</b>
            <span class="badge bg-info text-dark">@Model.Rol</span>
        </p>

        <a asp-action="Index" class="btn btn-primary mt-3">
            Volver
        </a>

    </div>

</div>