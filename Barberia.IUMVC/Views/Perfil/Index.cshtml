@model List<Barberia.Entidades.Cita>

<h2 class="mb-4">👤 Perfil del Cliente</h2>

<div class="card mb-4 shadow p-3">
    <h4>Información Personal</h4>
    <p><strong>Nombre:</strong> @ViewBag.Nombre</p>
    <p><strong>Correo:</strong> @ViewBag.Correo</p>
</div>

<div class="card shadow p-3">
    <h4>📅 Historial de Citas</h4>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>Barbero</th>
                <th>Servicio</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No tienes citas registradas
                    </td>
                </tr>
            }
            else
            {
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.NombreBarbero</td>
                        <td>@c.NombreServicio</td>
                        <td>@c.Fecha.ToShortDateString()</td>
                        <td>@c.Hora</td>

                        <td>
                            @if (c.Estado == "PROGRAMADA")
                            {
                                <span class="badge bg-success">Programada</span>
                            }
                            else if (c.Estado == "CANCELADA")
                            {
                                <span class="badge bg-danger">Cancelada</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@c.Estado</span>
                            }
                        </td>

                        <td>
                            @if (c.Estado == "PROGRAMADA")
                            {
                                <a asp-action="Cancelar"
                                   asp-route-id="@c.IdCita"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('¿Cancelar esta cita?');">
                                    ❌ Cancelar
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Sin acciones</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">
        ⬅ Volver
    </a>
</div>