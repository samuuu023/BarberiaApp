<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - COOL BARBER SHOP</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    💈 COOL BARBER SHOP
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">

                    <ul class="navbar-nav me-auto">

                        @if (Context.Session.GetString("usuario") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>

                            @if (Context.Session.GetString("rol") == "ADMIN")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cliente" asp-action="Index">Clientes</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Barbero" asp-action="Index">Barberos</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Servicios" asp-action="Index">Servicios</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Citas" asp-action="Index">Citas</a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav">

                        @if (Context.Session.GetString("usuario") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-white">
                                    👤 @Context.Session.GetString("usuario")
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Login" asp-action="Logout">
                                    Cerrar sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info" asp-controller="Login" asp-action="Index">
                                    Iniciar sesión
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-success" asp-controller="Login" asp-action="Registro">
                                    Registrarse
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="text-center mt-5">
        <hr />
        <p>© 2026 - COOL BARBER SHOP 💈</p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>